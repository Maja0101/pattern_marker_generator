{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run/Debug pattern_marker_generator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "targetArchitecture": "x86_64",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "--nx --quiet",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable styled GDB output",
                    "text": "-gdb-set style enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod prompt",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "logging": {
                "engineLogging": true
            },
            "customLaunchSetupCommands": [
                {
                    "description": "Set working directory",
                    "text": "-environment-cd ${workspaceFolder}",
                    "ignoreFailures": false
                },
                {
                    "description": "Load executable with symbols",
                    "text": "-file-exec-and-symbols ${command:cmake.launchTargetPath}",
                    "ignoreFailures": false
                },
                {
                    "description": "Disable debuginfod after MIEngine init",
                    "text": "interpreter-exec console \"set debuginfod enabled off\"",
                    "ignoreFailures": true
                },
                {
                    "description": "Set entry breakpoint",
                    "text": "-break-insert -f main",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Run/Debug unit_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/unit_tests",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "targetArchitecture": "x86_64",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "--nx --quiet",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable styled GDB output",
                    "text": "-gdb-set style enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod prompt",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "logging": {
                "engineLogging": true
            },
            "customLaunchSetupCommands": [
                {
                    "description": "Set working directory",
                    "text": "-environment-cd ${workspaceFolder}",
                    "ignoreFailures": false
                },
                {
                    "description": "Load executable with symbols",
                    "text": "-file-exec-and-symbols ${workspaceFolder}/build/debug/unit_tests",
                    "ignoreFailures": false
                },
                {
                    "description": "Disable debuginfod after MIEngine init",
                    "text": "interpreter-exec console \"set debuginfod enabled off\"",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}