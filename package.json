{
  "name": "@cut-sense/nesting-engine",
  "version": "1.0.0",
  "description": "C++ nesting engine responsible for generating pattern marker",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "CMakeLists.txt",
    "src",
    "libs"
  ],
  "scripts": {
    "install": "npx submodules-install && cmake-js compile --isRelease --CDBUILD_TESTING=OFF",
    "build": "cmake-js compile --isRelease --CDBUILD_TESTING=OFF",
    "build:debug": "cmake-js compile --CDBUILD_TESTING=OFF",
    "clean": "cmake-js clean"
  },
  "dependencies": {
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "submodules-install": "^1.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "submodules": [
    {
      "name": "clipper2",
      "url": "https://github.com/PolyClipping/Clipper2.git",
      "path": "libs/clipper2"
    }
  ]
}